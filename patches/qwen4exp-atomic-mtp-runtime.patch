+void ggml_vec_dot_iq4_nl_q8_0_4rows(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy) {
+    assert(n % QK4_NL == 0);
+    static_assert(QK4_NL == QK8_0, "QK4_NL and QK8_0 must be the same");
+
+#if defined __AVX2__
+    const block_iq4_nl * GGML_RESTRICT x[4];
